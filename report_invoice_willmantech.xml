<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_willmantech_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page">
                <div class="row mb-4">
                    <div class="col-6">
                        <h2>Factura: <span campo="doc.name"/></h2>
                        <p><strong>Fecha de Emisión:</strong> <span campo="doc.date_invoice" t-options='{"widget": "date"}'/></p>
                    </div>
                    <div class="col-6 text-right">
                        <h4>Cliente</h4>
                        <div campo="doc.partner_id" t-options='{"widget": "contact", "fields": ["address", "name", "email"], "no_marker": True}'/>
                    </div>
                </div>

                <t t-set="display_discount" t-value="any(line.discount > 0 for line in doc.invoice_line_ids)"/>

                <table class="table table-sm table-striped mt-4">
                    <thead>
                        <tr>
                            <th class="text-left">Descripción</th>
                            <th class="text-right">Cantidad</th>
                            <th class="text-right">Precio Unitario</th>
                            <t t-if="display_discount">
                                <th class="text-right">Desc. (%)</th>
                            </t>
                            <th class="text-right">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.invoice_line_ids" t-as="line">
                            <tr>
                                <td><span campo="line.name"/></td>
                                <td class="text-right"><span campo="line.quantity"/></td>
                                <td class="text-right"><span campo="line.price_unit"/></td>
                                <t t-if="display_discount">
                                    <td class="text-right"><span campo="line.discount"/></td>
                                </t>
                                <td class="text-right"><span campo="line.price_subtotal"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row justify-content-end mt-4">
                    <div class="col-4">
                        <table class="table table-sm borderless">
                            <tr>
                                <td><strong>Base Imponible:</strong></td>
                                <td class="text-right"><span campo="doc.amount_untaxed"/></td>
                            </tr>
                            <tr>
                                <td><strong>Impuestos:</strong></td>
                                <td class="text-right"><span campo="doc.amount_tax"/></td>
                            </tr>
                            <tr class="border-top">
                                <td><h3><strong>Total:</strong></h3></td>
                                <td class="text-right"><h3><span campo="doc.amount_total"/></h3></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>